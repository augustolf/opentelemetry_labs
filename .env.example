# ===================
# Celery Configuration
# ===================
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# ===================
# OpenTelemetry Configuration (auto-instrumentation)
# ===================
# Uses `opentelemetry-instrument` agent — no manual SDK init needed

# OTLP Exporter endpoint (local collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta

# Service identification
OTEL_SERVICE_NAME=flask-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=1.0.0

# Log correlation & auto-instrumentation
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# ===================
# Dynatrace Configuration (for production)
# ===================
# Get these values from your Dynatrace environment:
# 1. Environment ID: Found in your Dynatrace URL (https://{ENVIRONMENT_ID}.live.dynatrace.com)
# 2. API Token: Settings > Access Tokens > Generate New Token
#    Required scopes: logs.ingest, metrics.ingest, openTelemetryTrace.ingest
#
# Note: space in Authorization header is encoded as %20 (W3C Baggage convention)

# DYNATRACE_ENVIRONMENT_ID=abc12345
# DYNATRACE_API_TOKEN=dt0c01.YOUR_TOKEN_HERE.XXXXXXXXXXXXXXXXXXXXXXX

# --- Option A: Via Collector (recommended) ---
# Keep OTEL_EXPORTER_OTLP_ENDPOINT pointing to the collector.
# Configure Dynatrace exporter in otel-collector-config.yaml instead.

# --- Option B: Direct to Dynatrace (without collector) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://{ENVIRONMENT_ID}.live.dynatrace.com/api/v2/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token%20{TOKEN}

# ===================
# Flask Configuration
# ===================
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-this-in-production

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
